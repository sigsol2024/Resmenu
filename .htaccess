# Restaurant Menu Platform .htaccess

# Directory index priority (PHP for marketing site)
DirectoryIndex index.php index.html

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Restaurant checkout
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^restaurant/([a-z0-9-]+)/checkout/?$ checkout.php?slug=$1 [L,QSA]
    
    # Restaurant table reservation (Template 4 only)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^restaurant/([a-z0-9-]+)/reservation/?$ reservation.php?slug=$1 [L,QSA]
    
    # Restaurant section sub-page (e.g. /restaurant/the-lusso-restaurant/food) — must be before single-segment rule
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^restaurant/([a-z0-9-]+)/([a-z0-9-]+)/?$ restaurant.php?slug=$1&section=$2 [L,QSA]
    
    # Restaurant full menu
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^restaurant/([a-z0-9-]+)/?$ restaurant.php?slug=$1 [L,QSA]
    
    # QR code redirect
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^qr/([a-z0-9-]+)/?$ qr/index.php?slug=$1 [L,QSA]
    
    # Admin restaurant management
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^admin/restaurant/([a-z0-9-]+)/?$ admin/restaurant-view.php?slug=$1 [L,QSA]
    
    # Manager dashboard (slug-based)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^manager/([a-z0-9-]+)/?$ manager/dashboard.php?slug=$1 [L,QSA]

    # Template preview (template1-preview, template2-preview, … template20-preview; new templates get same preview + viewport widget)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^template([0-9]+)-preview/?$ template-preview.php?t=$1 [L,QSA]
</IfModule>

# Security Headers (allow template preview to be embedded in iframe on resmenu.net)
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/template[0-9]+-preview" allow_embed
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN" env=!allow_embed
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(sql|md|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow PHP execution in HTML files for marketing pages
AddType application/x-httpd-php .html

# PHP Settings
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

